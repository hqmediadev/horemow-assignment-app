rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isOverseer() {
      return signedIn() && request.auth.token.get('overseer', false) == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isOverseer();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.accountType == 'member';

      allow update: if (
          isOwner(userId)
          && request.resource.data.uid == userId
          && request.resource.data.accountType == resource.data.accountType
          && request.resource.data.get('overseerNote', null) == resource.data.get('overseerNote', null)
        ) || (
          isOverseer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['overseerNote'])
        );

      allow delete: if isOwner(userId);
    }
  }
}
